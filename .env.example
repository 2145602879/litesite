# ============================================================
#  litesite 环境变量模板
#  用法：复制为 .env 后按需修改，然后重启服务
#  cp .env.example .env && chmod 600 .env
# ============================================================

# ---------- 运行环境 ----------
# production 会开启更严格的安全策略（Cookie Secure 等）
NODE_ENV=production
# Node 只监听本机，由 Nginx 反向代理对外提供服务（务必不要监听 0.0.0.0）
HOST=127.0.0.1
PORT=3000
# 在 Nginx 反代后面，需要信任代理才能拿到真实访客 IP
TRUST_PROXY=true

# ---------- 站点信息 ----------
SITE_TITLE=我的个人主页
SITE_DESCRIPTION=设计、代码与一点点固执
SITE_URL=https://example.com

# ---------- 管理员初始账号（仅首次初始化数据库时使用）----------
# 数据库里已存在管理员后，修改这里不会改动密码；
# 改密码请用后台「安全设置」或 npm run reset-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_2024

# ---------- 安全 ----------
# 会话签名密钥，必须随机且保密。生成方式：
#   openssl rand -hex 32
# 留空时启动会自动生成随机值（但重启后所有登录会话失效）
SESSION_SECRET=
# 登录失败防爆破：窗口内允许的失败次数 / 封禁时长
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=10
LOGIN_BLOCK_MINUTES=15
# 会话有效期（小时）
SESSION_TTL_HOURS=168
# 全站 HTTPS 后设为 true（.env 里配置了域名证书就打开）
COOKIE_SECURE=false

# ---------- 数据与上传 ----------
# SQLite 数据库目录（单文件数据库，便于备份）
DATA_DIR=./data
# 上传目录（Nginx 会直接托管该目录，Node 不参与静态文件传输）
UPLOAD_DIR=./public/uploads
# 单张图片大小上限（KB）
UPLOAD_MAX_KB=2048
# 请求体上限
BODY_LIMIT=128kb

# ---------- 作品集数据源 ----------
# 填了 GITHUB_USERNAME 就用 GitHub 仓库当作品集（推荐），留空则用后台手动录入的作品。
# 想强制用手动数据源：PORTFOLIO_SOURCE=manual
PORTFOLIO_SOURCE=
GITHUB_USERNAME=

# 可选：只展示这些仓库，并严格按此顺序排列（逗号分隔的仓库名）
# 留空则自动收录全部公开仓库，按星标数 + 最近推送排序，新仓库会自动出现
GITHUB_REPOS=

# 可选：GitHub 令牌。匿名接口按 IP 限 60 次/小时，配令牌可提升到 5000 次/小时，
# 并且能读取私有仓库。只读权限即可（fine-grained token 勾 Public Repositories 的只读）
GITHUB_TOKEN=

# 抓取策略
GITHUB_EXCLUDE_FORKS=true
GITHUB_EXCLUDE_ARCHIVED=false
# 最多展示几个仓库
GITHUB_MAX=12
# 缓存时长（分钟）。GitHub 侧变更不会那么快，30 分钟足够，
# 且过期后也是先返回旧数据再后台刷新，访客不会等待
GITHUB_CACHE_MINUTES=30
# 单次抓取超时（毫秒）
GITHUB_TIMEOUT_MS=8000
